+    // https://support.google.com/a/answer/166852
+    dailyLimit: 2000,
+    helpUrl: "https://support.google.com/a/answer/7281227",
+    id: "google_workspace",
+    method: "oauth",
+    name: "Google Workspace",
+    oauth: "google",
+    perMinuteLimit: null,
+    provider: "gmail",
+    smtpDefaults: null,
+    smtpHosts: [],
+    usernameIsAddress: false,
+  },
+  microsoft365: {
+    appPasswordRequired: false,
+    // https://learn.microsoft.com/office365/servicedescriptions/exchange-online-service-description/exchange-online-limits#sending-limits
+    dailyLimit: 10000,
+    helpUrl:
+      "https://learn.microsoft.com/entra/identity/enterprise-apps/grant-admin-consent",
+    id: "microsoft365",
+    method: "oauth",
+    name: "Microsoft 365",
+    oauth: "microsoft",
+    perMinuteLimit: 30,
+    provider: "microsoft",
+    smtpDefaults: null,
+    smtpHosts: [],
+    usernameIsAddress: false,
+  },
+  outlook: {
+    appPasswordRequired: false,
+    // Outlook.com limits new and personal accounts well below Microsoft 365.
+    dailyLimit: 300,
+    helpUrl: "https://account.live.com/consent/Manage",
+    id: "outlook",
+    method: "oauth",
+    name: "Outlook.com / Hotmail",
+    oauth: "microsoft",
+    perMinuteLimit: 30,
+    provider: "microsoft",
+    smtpDefaults: null,
+    smtpHosts: [],
+    usernameIsAddress: false,
+  },
+  zoho: {
+    appPasswordRequired: false,
+    // Zoho's free and lite plans are limited; this stays well inside them.
+    dailyLimit: 250,
+    helpUrl: "https://www.zoho.com/mail/help/zoho-smtp.html",
+    id: "zoho",
+    method: "smtp",
+    name: "Zoho Mail",
+    oauth: null,
+    perMinuteLimit: null,
+    provider: "smtp",
+    smtpDefaults: { host: "smtp.zoho.com", port: 465, security: "tls" },
+    // Accounts in Zoho's EU and India data centres use their own hosts.
+    smtpHosts: ["smtp.zoho.com", "smtp.zoho.eu", "smtp.zoho.in"],
+    usernameIsAddress: true,
+  },
+  yahoo: {
+    appPasswordRequired: true,
+    dailyLimit: 500,
+    helpUrl: "https://help.yahoo.com/kb/SLN15241.html",
+    id: "yahoo",
+    method: "smtp",
+    name: "Yahoo Mail",
+    oauth: null,
+    perMinuteLimit: null,
+    provider: "smtp",
+    smtpDefaults: { host: "smtp.mail.yahoo.com", port: 465, security: "tls" },
+    smtpHosts: ["smtp.mail.yahoo.com"],
+    usernameIsAddress: true,
+  },
+  icloud: {
+    appPasswordRequired: true,
+    // https://support.apple.com/en-us/102198
+    dailyLimit: 1000,
+    helpUrl: "https://support.apple.com/en-us/102654",
+    id: "icloud",
+    method: "smtp",
+    name: "iCloud Mail",
+    oauth: null,
+    perMinuteLimit: null,
+    provider: "smtp",
+    smtpDefaults: { host: "smtp.mail.me.com", port: 587, security: "starttls" },
+    smtpHosts: ["smtp.mail.me.com"],
+    usernameIsAddress: true,
+  },
+  smtp: {
+    appPasswordRequired: false,
+    dailyLimit: null,
+    helpUrl: null,
+    id: "smtp",
+    method: "smtp",
+    name: "Other (SMTP)",
+    oauth: null,
+    perMinuteLimit: null,
+    provider: "smtp",
+    smtpDefaults: null,
+    smtpHosts: [],
+    usernameIsAddress: false,
+  },
+  resend: {
+    appPasswordRequired: false,
+    // Resend enforces its own quotas and says so when one is used up.
+    dailyLimit: null,
+    helpUrl: "https://resend.com/docs/dashboard/api-keys/introduction",
+    id: "resend",
+    method: "api",
+    name: "Resend",
+    oauth: null,
+    perMinuteLimit: null,
+    provider: "resend",
+    smtpDefaults: null,
+    smtpHosts: [],
+    usernameIsAddress: false,
+  },
+};
+
+export type ProviderOption = {
+  appPasswordRequired: boolean;
+  available: boolean;
+  helpUrl: string | null;
+  id: ProviderPresetId;
+  method: "oauth" | "smtp" | "api";
+  name: string;
+  smtpDefaults: ProviderPreset["smtpDefaults"];
+  unavailableReason: string | null;
+};
+
+export function isProviderPresetId(value: unknown): value is ProviderPresetId {
+  return (
+    typeof value === "string" &&
+    (PROVIDER_PRESET_IDS as readonly string[]).includes(value)
+  );
+}
+
+export function getPreset(id: ProviderPresetId): ProviderPreset {
+  return PROVIDER_PRESETS[id];
+}
+
+export type OAuthClientConfig = {
+  clientId: string;
+  clientSecret: string;
+  /** Microsoft only: the tenant to sign in against. */
+  tenant: string;
+};
+
+const OAUTH_ENV = {
+  google: ["GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"],
+  microsoft: ["MICROSOFT_CLIENT_ID", "MICROSOFT_CLIENT_SECRET"],
+} as const;
+
+/** The OAuth app's credentials, or null when the administrator has set none. */
+export function readOAuthClient(
+  provider: OAuthProviderName,
+  env: EnvSource = process.env,
+): OAuthClientConfig | null {
+  const [idName, secretName] = OAUTH_ENV[provider];
+  const clientId = readEnv(env, idName);
+  const clientSecret = readEnv(env, secretName);
+
+  if (!clientId || !clientSecret) {
+    return null;
+  }
+
+  return {
+    clientId,
+    clientSecret,
+    tenant:
+      provider === "microsoft"
+        ? (readEnv(env, "MICROSOFT_TENANT_ID") ?? "common")
+        : "",
+  };
+}
+
+export function unavailableReasonFor(
+  preset: ProviderPreset,
+  env: EnvSource = process.env,
+): string | null {
+  if (!preset.oauth || readOAuthClient(preset.oauth, env)) {
+    return null;
+  }
+
+  const [idName, secretName] = OAUTH_ENV[preset.oauth];
+
+  return `Awaiting administrator configuration: set ${idName} and ${secretName}`;
+}
+
+export function listProviderOptions(
+  env: EnvSource = process.env,
+): ProviderOption[] {
+  return PROVIDER_PRESET_IDS.map((id) => {
+    const preset = PROVIDER_PRESETS[id];
+    const unavailableReason = unavailableReasonFor(preset, env);
+
+    return {
+      appPasswordRequired: preset.appPasswordRequired,
+      available: unavailableReason === null,
+      helpUrl: preset.helpUrl,
+      id,
+      method: preset.method,
+      name: preset.name,
+      smtpDefaults: preset.smtpDefaults,
+      unavailableReason,
+    };
+  });
+}
+
+/** What a provider calls the place its mailbox is reconnected. */
+export function reconnectRecovery(preset: ProviderPreset): string {
+  return `Reconnect the ${preset.name} account in Settings > Email & Integrations.`;
+}
diff --git a/src/lib/email/resend.ts b/src/lib/email/resend.ts
new file mode 100644
index 0000000..42e2684
--- /dev/null
+++ b/src/lib/email/resend.ts
@@ -0,0 +1,232 @@
+import { Resend } from "resend";
+
+import { kindForHttpStatus, retryAfterMs } from "./classify.ts";
+import {
+  EmailTransportError,
+  type EmailTransport,
+  type MailboxAddress,
+  type OutgoingMessage,
+} from "./types.ts";
+
+// Resend, with its API key: either the install's RESEND_API_KEY or an
+// account connected in Settings > Email & Integrations.
+
+/**
+ * Resend accepts up to 40 MB per message once attachments are base64
+ * encoded, which makes them a third larger.
+ */
+export const RESEND_MAX_ATTACHMENT_BYTES = 25 * 1024 * 1024;
+
+/** How often a message Resend turned away for rate is tried again. */
+const RATE_LIMIT_RETRIES = 3;
+const DEFAULT_RATE_LIMIT_WAIT_MS = 1_000;
+const MAX_RATE_LIMIT_WAIT_MS = 5_000;
+
+type ResendError = { message?: string; name?: string; statusCode?: number | null };
+
+type ResendResult = {
+  error: ResendError | null;
+  headers: Record<string, string> | null;
+};
+
+export type ResendClient = Pick<Resend, "batch" | "emails">;
+
+function rateLimitWaitMs(headers: Record<string, string> | null): number {
+  const seconds = Number(headers?.["retry-after"]);
+
+  return Number.isFinite(seconds) && seconds > 0
+    ? Math.min(seconds * 1000, MAX_RATE_LIMIT_WAIT_MS)
+    : DEFAULT_RATE_LIMIT_WAIT_MS;
+}
+
+/**
+ * Resend allows a team so many requests a second, across everything that
+ * uses its key. A request over that is refused, not queued, so it is tried
+ * again after the wait Resend names. A used-up daily or monthly quota is
+ * also a 429, and is not retried here: a second's wait does not bring it
+ * back.
+ */
+async function sendWithinRateLimit<T extends ResendResult>(
+  request: () => Promise<T>,
+  wait: (milliseconds: number) => Promise<void>,
+): Promise<T> {
+  for (let attempt = 0; ; attempt += 1) {
+    const result = await request();
+
+    if (
+      result.error?.name !== "rate_limit_exceeded" ||
+      attempt >= RATE_LIMIT_RETRIES
+    ) {
+      return result;
+    }
+
+    await wait(rateLimitWaitMs(result.headers));
+  }
+}
+
+export function waitFor(milliseconds: number): Promise<void> {
+  return new Promise((resolve) => {
+    setTimeout(resolve, milliseconds);
+  });
+}
+
+const AUTH_ERRORS = new Set([
+  "invalid_api_key",
+  "missing_api_key",
+  "restricted_api_key",
+  "invalid_access",
+]);
+
+/** Resend's error as an EmailTransportError of the right kind. */
+export function toResendError(
+  error: ResendError,
+  headers: Record<string, string> | null = null,
+): EmailTransportError {
+  const status = typeof error.statusCode === "number" ? error.statusCode : null;
+  const name = error.name ?? null;
+  let kind = status === null ? "transient" : kindForHttpStatus(status);
+
+  if (name && AUTH_ERRORS.has(name)) {
+    kind = "auth";
+  } else if (
+    name === "rate_limit_exceeded" ||
+    name === "daily_quota_exceeded" ||
+    name === "monthly_quota_exceeded" ||
+    name === "application_error" ||
+    name === "internal_server_error"
+  ) {
+    kind = "transient";
+  } else if (name === "validation_error" || name === "invalid_from_address") {
+    // An unverified domain, a malformed address: the message will not go
+    // out like this, however often it is tried.
+    kind = "permanent";
+  }
+
+  return new EmailTransportError(error.message || "Email delivery failed.", {
+    code: name,
+    kind: kind as EmailTransportError["kind"],
+    retryAfterMs: retryAfterMs(headers?.["retry-after"]),
+    statusCode: status,
+  });
+}
+
+/** "Name <address>", quoting the name when it needs it. */
+export function formatMailbox({ address, name }: MailboxAddress): string {
+  if (!name) {
+    return address;
+  }
+
+  const quoted = /[",.;:<>@()[\]\\]/.test(name)
+    ? `"${name.replace(/["\\]/g, "\\$&")}"`
+    : name;
+
+  return `${quoted} <${address}>`;
+}
+
+export function buildResendPayload(message: OutgoingMessage) {
+  return {
+    ...(message.attachments.length
+      ? {
+          attachments: message.attachments.map((attachment) => ({
+            content: Buffer.from(attachment.content),
+            contentType: attachment.contentType,
+            filename: attachment.filename,
+          })),
+        }
+      : {}),
+    from: formatMailbox(message.from),
+    html: message.htmlBody,
+    replyTo: message.replyTo ?? undefined,
+    subject: message.subject,
+    tags: [{ name: "category", value: message.template }],
+    text: message.textBody,
+    to: [message.to],
+  };
+}
+
+export type ResendTransport = EmailTransport & {
+  sendBatch(
+    messages: readonly OutgoingMessage[],
+    idempotencyKey?: string,
+  ): Promise<{ providerMessageId?: string }[]>;
+};
+
+export function createResendTransport({
+  apiKey,
+  client,
+  wait = waitFor,
+}: {
+  apiKey?: string;
+  client?: ResendClient;
+  wait?: (milliseconds: number) => Promise<void>;
+}): ResendTransport {
+  const resend = client ?? new Resend(apiKey);
+
+  return {
+    maxAttachmentBytes: RESEND_MAX_ATTACHMENT_BYTES,
+    provider: "resend",
+    async send(message) {
+      const result = await sendWithinRateLimit(
+        () =>
+          resend.emails.send(
+            buildResendPayload(message),
+            message.idempotencyKey
+              ? { idempotencyKey: message.idempotencyKey }
+              : undefined,
+          ) as Promise<ResendResult & { data: { id: string } | null }>,
+        wait,
+      );
+
+      if (result.error) {
+        throw toResendError(result.error, result.headers);
+      }
+
+      return { providerMessageId: result.data?.id };
+    },
+    async sendBatch(messages, idempotencyKey) {
+      if (messages.length === 0) {
+        return [];
+      }
+
+      const result = await sendWithinRateLimit(
+        () =>
+          resend.batch.send(
+            messages.map((message) => buildResendPayload(message)),
+            idempotencyKey ? { idempotencyKey } : undefined,
+          ) as Promise<
+            ResendResult & { data: { data: { id: string }[] } | null }
+          >,
+        wait,
+      );
+
+      if (result.error) {
+        throw toResendError(result.error, result.headers);
+      }
+
+      return messages.map((_, index) => ({
+        providerMessageId: result.data?.data[index]?.id,
+      }));
+    },
+  };
+}
+
+/**
+ * Whether this API key belongs to a Resend account. A key that may only
+ * send cannot list domains, and says so: that still proves the key is real.
+ */
+export async function verifyResendApiKey(
+  apiKey: string,
+  client: Pick<Resend, "domains"> = new Resend(apiKey),
+): Promise<void> {
+  const result = await client.domains.list();
+
+  // Resend uses this name twice: with 401 for a key that may only send,
+  // and with 403 for a key that has been switched off.
+  const sendOnly =
+    result.error?.name === "restricted_api_key" &&
+    (result.error as ResendError).statusCode !== 403;
+
+  if (result.error && !sendOnly) {
+    throw toResendError(result.error as ResendError);
+  }
+}
diff --git a/src/lib/email/smtp.ts b/src/lib/email/smtp.ts
new file mode 100644
index 0000000..5da678a
--- /dev/null
+++ b/src/lib/email/smtp.ts
@@ -0,0 +1,310 @@
+import { lookup as dnsLookup } from "node:dns/promises";
+import { isIP } from "node:net";
+
+import nodemailer from "nodemailer";
+
+import { isPrivateAddress } from "../services/private-address.ts";
+import { readEnv, type EnvSource } from "../utils/env.ts";
+import { kindForSmtpError } from "./classify.ts";
+import { toNodemailerMessage } from "./mime.ts";
+import { type SmtpSecurity } from "./presets.ts";
+import {
+  EmailTransportError,
+  type EmailTransport,
+  type OutgoingMessage,
+} from "./types.ts";
+
+// SMTP through nodemailer, for Zoho, Yahoo, iCloud and any other server.
+//
+// The server's name comes from whoever connects the account, so it is
+// treated like any other address from outside:
+//
+// - Only the mail ports (25, 465, 587, 2525), and only with TLS: implicit
+//   TLS on 465, or STARTTLS that must succeed (requireTLS) elsewhere.
+// - The name is looked up once, and an address in a private, loopback or
+//   link-local range is refused (SMTP_ALLOW_PRIVATE_HOSTS=1 allows them
+//   for a relay on the operator's own network, and for tests).
+// - The connection is made to that one address, with the original name as
+//   the TLS server name, so the certificate is still checked against the
+//   name. A second lookup that answers differently (DNS rebinding) is
+//   never made.
+
+export const ALLOWED_SMTP_PORTS = [25, 465, 587, 2525] as const;
+
+/** Most servers take 25 MB or more; base64 grows it by a third on the wire. */
+export const SMTP_MAX_ATTACHMENT_BYTES = 18 * 1024 * 1024;
+
+const CONNECTION_TIMEOUT_MS = 15_000;
+const GREETING_TIMEOUT_MS = 15_000;
+const SOCKET_TIMEOUT_MS = 30_000;
+
+export type SmtpSettings = {
+  host: string;
+  password: string;
+  port: number;
+  security: SmtpSecurity;
+  username: string;
+};
+
+export type ResolveAddresses = (
+  host: string,
+) => Promise<{ address: string; family: number }[]>;
+
+export type SmtpTransportOptions = {
+  env?: EnvSource;
+  /** Replaced in tests to answer like a DNS server would. */
+  lookup?: ResolveAddresses;
+  /**
+   * Internal, for tests: a certificate authority to trust for this
+   * connection only, so a local test server's own certificate verifies.
+   * Verification itself is never turned off.
+   */
+  trustedCa?: string;
+};
+
+const defaultLookup: ResolveAddresses = (host) =>
+  dnsLookup(host, { all: true, verbatim: true });
+
+const HOST_PATTERN =
+  /^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)*[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$/;
+
+export function normalizeSmtpHost(host: string): string {
+  return host.trim().toLowerCase().replace(/\.$/, "");
+}
+
+/** What is wrong with these settings, field by field; empty when nothing. */
+export function checkSmtpEndpoint(input: {
+  host: string;
+  port: number;
+  security: SmtpSecurity;
+}): Record<string, string> {
+  const errors: Record<string, string> = {};
+  const host = normalizeSmtpHost(input.host);
+
+  if (!host || (!isIP(host.replace(/^\[|\]$/g, "")) && !HOST_PATTERN.test(host))) {
+    errors.host = "Enter the SMTP server's host name, such as smtp.example.com.";
+  }
+
+  if (!(ALLOWED_SMTP_PORTS as readonly number[]).includes(input.port)) {
+    errors.port = "Use port 465 (TLS), 587 (STARTTLS), 25 or 2525.";
+  } else if (input.port === 465 && input.security !== "tls") {
+    errors.security = "Port 465 uses TLS from the start. Choose TLS.";
+  } else if (input.port !== 465 && input.security === "tls") {
+    errors.security = `Port ${String(input.port)} uses STARTTLS. Choose STARTTLS, or port 465 for TLS.`;
+  }
+
+  return errors;
+}
+
+function refused(message: string): EmailTransportError {
+  return new EmailTransportError(message, {
+    code: "smtp_host_refused",
+    kind: "permanent",
+  });
+}
+
+/**
+ * The one address this host is dialled at. Looked up once; refused when
+ * it is private and private hosts are not allowed.
+ */
+export async function resolveSmtpAddress(
+  host: string,
+  { env = process.env, lookup = defaultLookup }: SmtpTransportOptions = {},
+): Promise<string> {
+  const name = normalizeSmtpHost(host).replace(/^\[|\]$/g, "");
+  const allowPrivate = readEnv(env, "SMTP_ALLOW_PRIVATE_HOSTS") === "1";
+  let addresses: string[];
+
+  if (isIP(name)) {
+    addresses = [name];
+  } else {
+    if (!allowPrivate && isPrivateAddress(name)) {
+      throw refused(`${name} is a local address. Use the mail server's public name.`);
+    }
+
+    try {
+      addresses = (await lookup(name)).map((entry) => entry.address);
+    } catch (error) {
+      const code = (error as { code?: unknown }).code;
+
+      throw new EmailTransportError(
+        code === "ENOTFOUND" || code === "ENODATA"
+          ? `The SMTP server ${name} was not found. Check its name.`
+          : `The SMTP server ${name} could not be looked up.`,
+        {
+          code: typeof code === "string" ? code : "EDNS",
+          kind:
+            code === "ENOTFOUND" || code === "ENODATA" ? "permanent" : "transient",
+        },
+      );
+    }
+  }
+
+  const usable = allowPrivate
+    ? addresses
+    : addresses.filter((address) => !isPrivateAddress(address));
+
+  if (usable.length === 0) {
+    throw refused(
+      addresses.length === 0
+        ? `The SMTP server ${name} has no address.`
+        : `${name} points to a private network address, which PACTORA does not connect to.`,
+    );
+  }
+
+  return usable[0]!;
+}
+
+function buildNodemailerOptions(
+  settings: SmtpSettings,
+  address: string,
+  options: SmtpTransportOptions,
+) {
+  const host = normalizeSmtpHost(settings.host).replace(/^\[|\]$/g, "");
+  const servername = isIP(host) ? undefined : host;
+
+  return {
+    auth: { pass: settings.password, user: settings.username },
+    connectionTimeout: CONNECTION_TIMEOUT_MS,
+    greetingTimeout: GREETING_TIMEOUT_MS,
+    // The address looked up above, never the name: see the top of the file.
+    host: address,
+    ignoreTLS: false,
+    port: settings.port,
+    requireTLS: settings.security === "starttls",
+    secure: settings.security === "tls",
+    servername,
+    socketTimeout: SOCKET_TIMEOUT_MS,
+    tls: {
+      ...(options.trustedCa ? { ca: [options.trustedCa] } : {}),
+      minVersion: "TLSv1.2" as const,
+      rejectUnauthorized: true,
+      servername,
+    },
+  };
+}
+
+function describeSmtpError(error: unknown, host: string): string {
+  const code = (error as { code?: unknown }).code;
+  const response = (error as { response?: unknown }).response;
+
+  if (code === "EAUTH") {
+    return `${host} did not accept the user name and password${
+      typeof response === "string" ? ` (${response.slice(0, 200)})` : ""
+    }.`;
+  }
+
+  if (code === "ETLS" || /certificate|self.signed|altnames/i.test(String((error as Error).message))) {
+    return `The TLS connection to ${host} could not be verified: ${(error as Error).message}`;
+  }
+
+  if (code === "ETIMEDOUT") {
+    return `${host} did not answer in time.`;
+  }
+
+  if (code === "ECONNECTION" || code === "ECONNREFUSED" || code === "ESOCKET") {
+    return `Could not connect to ${host}: ${(error as Error).message}`;
+  }
+
+  return error instanceof Error && error.message
+    ? error.message
+    : `${host} refused the message.`;
+}
+
+function toSmtpError(error: unknown, host: string): EmailTransportError {
+  if (error instanceof EmailTransportError) {
+    return error;
+  }
+
+  const code = (error as { code?: unknown }).code;
+  const responseCode = (error as { responseCode?: unknown }).responseCode;
+
+  return new EmailTransportError(describeSmtpError(error, host), {
+    code: typeof code === "string" ? code : null,
+    kind: kindForSmtpError(error),
+    statusCode: typeof responseCode === "number" ? responseCode : null,
+  });
+}
+
+async function withConnection<T>(
+  settings: SmtpSettings,
+  options: SmtpTransportOptions,
+  run: (transporter: nodemailer.Transporter) => Promise<T>,
+): Promise<T> {
+  const endpointErrors = checkSmtpEndpoint(settings);
+  const firstError = Object.values(endpointErrors)[0];
+
+  if (firstError) {
+    throw refused(firstError);
+  }
+
+  const address = await resolveSmtpAddress(settings.host, options);
+  const transporter = nodemailer.createTransport(
+    buildNodemailerOptions(settings, address, options),
+  );
+
+  try {
+    return await run(transporter);
+  } catch (error) {
+    throw toSmtpError(error, normalizeSmtpHost(settings.host));
+  } finally {
+    transporter.close();
+  }
+}
+
+/** Connects, starts TLS and signs in, without sending anything. */
+export async function verifySmtpSettings(
+  settings: SmtpSettings,
+  options: SmtpTransportOptions = {},
+): Promise<void> {
+  await withConnection(settings, options, async (transporter) => {
+    await transporter.verify();
+  });
+}
+
+export function createSmtpTransport(
+  settings: SmtpSettings,
+  options: SmtpTransportOptions = {},
+): EmailTransport {
+  return {
+    maxAttachmentBytes: SMTP_MAX_ATTACHMENT_BYTES,
+    provider: "smtp",
+    send: (message: OutgoingMessage) =>
+      withConnection(settings, options, async (transporter) => {
+        const info = (await transporter.sendMail(
+          toNodemailerMessage(message),
+        )) as { messageId?: string; rejected?: unknown[] };
+
+        if (Array.isArray(info.rejected) && info.rejected.length > 0) {
+          throw new EmailTransportError(
+            `${normalizeSmtpHost(settings.host)} refused the recipient ${message.to}.`,
+            { code: "EENVELOPE", kind: "permanent" },
+          );
+        }
+
+        return { providerMessageId: info.messageId };
+      }),
+  };
+}
+
+/**
+ * PLATFORM_SMTP_URL: smtps://user:password@host:465 for implicit TLS, or
+ * smtp://user:password@host:587 for STARTTLS (always required).
+ */
+export function parseSmtpUrl(value: string): SmtpSettings {
+  const url = new URL(value);
+
+  if (url.protocol !== "smtps:" && url.protocol !== "smtp:") {
+    throw new Error("PLATFORM_SMTP_URL must start with smtps:// or smtp://.");
+  }
+
+  const security: SmtpSecurity = url.protocol === "smtps:" ? "tls" : "starttls";
+
+  return {
+    host: url.hostname,
+    password: decodeURIComponent(url.password),
+    port: url.port ? Number(url.port) : security === "tls" ? 465 : 587,
+    security,
+    username: decodeURIComponent(url.username),
+  };
+}
diff --git a/src/lib/email/templates.ts b/src/lib/email/templates.ts
new file mode 100644
index 0000000..fa5b749
--- /dev/null
+++ b/src/lib/email/templates.ts
@@ -0,0 +1,264 @@
+import { getDb, queryMany, queryOne, type DbExecutor } from "../db/connection.ts";
+import { escapeHtml } from "../utils/html.ts";
+
+// An organisation's own wording for a few messages: the subject and the
+// opening paragraph. Everything else in the message (the greeting, the
+// links, the deadline, the legal footer) stays as PACTORA writes it, so a
+// template can never drop a signing link or a required notice.
+//
+// Placeholders are filled in from what PACTORA knows about the message and
+// HTML-escaped in the HTML part, so nothing typed into a document title or
+// a name can add markup.
+
+export const EDITABLE_TEMPLATE_KINDS = [
+  "signing_invitation",
+  "automatic_reminder",
+  "manual_nudge",
+  "completion_notification",
+  "workspace_invitation",
+] as const;
+
+export type EditableTemplateKind = (typeof EDITABLE_TEMPLATE_KINDS)[number];
+
+export const TEMPLATE_PLACEHOLDERS = [
+  "sender_name",
+  "document_title",
+  "organization_name",
+  "recipient_name",
+] as const;
+
+export type TemplatePlaceholder = (typeof TEMPLATE_PLACEHOLDERS)[number];
+export type TemplateVariables = Partial<Record<TemplatePlaceholder, string>>;
+
+export type TemplateCopy = { intro: string; subject: string };
+
+/** Today's wording, written with placeholders. The signer's version. */
+export const DEFAULT_TEMPLATE_COPY: Record<EditableTemplateKind, TemplateCopy> = {
+  automatic_reminder: {
+    intro:
+      '{{sender_name}} is still waiting for your signature on "{{document_title}}", sent through {{organization_name}}.',
+    subject:
+      'Reminder: {{sender_name}} is waiting for your signature on "{{document_title}}"',
+  },
+  completion_notification: {
+    intro:
+      '"{{document_title}}" from {{sender_name}} has been fully signed in {{organization_name}}.',
+    subject: '"{{document_title}}" is fully signed',
+  },
+  manual_nudge: {
+    intro:
+      '{{sender_name}} sent you a reminder to sign "{{document_title}}" through {{organization_name}}.',
+    subject: '{{sender_name}} sent you a reminder to sign "{{document_title}}"',
+  },
+  signing_invitation: {
+    intro:
+      '{{sender_name}} sent you "{{document_title}}" through {{organization_name}}.',
+    subject:
+      '{{sender_name}} requested your signature on "{{document_title}}"',
+  },
+  workspace_invitation: {
+    intro: "{{sender_name}} invited you to join {{organization_name}}.",
+    subject: "{{sender_name}} invited you to {{organization_name}}",
+  },
+};
+
+export function isEditableTemplateKind(
+  value: unknown,
+): value is EditableTemplateKind {
+  return (
+    typeof value === "string" &&
+    (EDITABLE_TEMPLATE_KINDS as readonly string[]).includes(value)
+  );
+}
+
+const PLACEHOLDER_PATTERN = /\{\{\s*([a-z_]+)\s*\}\}/g;
+
+/** The placeholders a text uses that PACTORA does not know. */
+export function unknownPlaceholders(text: string): string[] {
+  return [...text.matchAll(PLACEHOLDER_PATTERN)]
+    .map((match) => match[1]!)
+    .filter(
+      (name) => !(TEMPLATE_PLACEHOLDERS as readonly string[]).includes(name),
+    );
+}
+
+function fill(
+  text: string,
+  variables: TemplateVariables,
+  encode: (value: string) => string,
+): string {
+  let result = "";
+  let last = 0;
+
+  for (const match of text.matchAll(PLACEHOLDER_PATTERN)) {
+    const value = variables[match[1] as TemplatePlaceholder];
+
+    result += encode(text.slice(last, match.index));
+    result += value === undefined ? encode(match[0]) : encode(value);
+    last = match.index + match[0].length;
+  }
+
+  return result + encode(text.slice(last));
+}
+
+/** For a subject or a plain-text body. Line breaks are not allowed in a subject. */
+export function renderTemplateText(
+  text: string,
+  variables: TemplateVariables,
+): string {
+  return fill(text, variables, (value) => value);
+}
+
+/** For the HTML part: the template's own text and every value escaped. */
+export function renderTemplateHtml(
+  text: string,
+  variables: TemplateVariables,
+): string {
+  return fill(text, variables, escapeHtml);
+}
+
+export function renderSubject(
+  text: string,
+  variables: TemplateVariables,
+): string {
+  return renderTemplateText(text, variables).replace(/[\r\n]+/g, " ").trim();
+}
+
+/**
+ * The organisation's wording for this kind of message, or null when it
+ * uses PACTORA's own. A database without the table, or one that cannot be
+ * read, means PACTORA's own: the wording is never a reason not to send.
+ */
+export async function getTemplateCopy(
+  kind: EditableTemplateKind,
+  database: DbExecutor | null = null,
+): Promise<TemplateCopy | null> {
+  try {
+    return await queryOne<TemplateCopy>(
+      database ?? getDb(),
+      `SELECT subject, intro FROM email_templates WHERE kind = $1`,
+      [kind],
+    );
+  } catch {
+    return null;
+  }
+}
+
+export type TemplateView = {
+  defaultIntro: string;
+  defaultSubject: string;
+  intro: string;
+  isCustomized: boolean;
+  kind: EditableTemplateKind;
+  placeholders: readonly TemplatePlaceholder[];
+  subject: string;
+  updatedAt: number | null;
+};
+
+export async function listTemplates(
+  database: DbExecutor = getDb(),
+): Promise<TemplateView[]> {
+  const rows = await queryMany<
+    TemplateCopy & { kind: EditableTemplateKind; updatedAt: number }
+  >(
+    database,
+    `SELECT kind, subject, intro, updated_at AS "updatedAt" FROM email_templates`,
+  );
+  const stored = new Map(rows.map((row) => [row.kind, row]));
+
+  return EDITABLE_TEMPLATE_KINDS.map((kind) => {
+    const row = stored.get(kind);
+    const defaults = DEFAULT_TEMPLATE_COPY[kind];
+
+    return {
+      defaultIntro: defaults.intro,
+      defaultSubject: defaults.subject,
+      intro: row?.intro ?? defaults.intro,
+      isCustomized: Boolean(row),
+      kind,
+      placeholders: TEMPLATE_PLACEHOLDERS,
+      subject: row?.subject ?? defaults.subject,
+      updatedAt: row?.updatedAt ?? null,
+    };
+  });
+}
+
+export class TemplateValidationError extends Error {
+  readonly fieldErrors: Record<string, string>;
+
+  constructor(fieldErrors: Record<string, string>) {
+    super(Object.values(fieldErrors)[0] ?? "Check the template.");
+    this.name = "TemplateValidationError";
+    this.fieldErrors = fieldErrors;
+  }
+}
+
+/**
+ * Saves the wording for one kind. Saving PACTORA's own wording, or empty
+ * text, goes back to it.
+ */
+export async function saveTemplate(
+  input: { intro: string; kind: EditableTemplateKind; subject: string },
+  userId: string,
+  database: DbExecutor = getDb(),
+): Promise<void> {
+  const subject = input.subject.trim();
+  const intro = input.intro.trim();
+  const defaults = DEFAULT_TEMPLATE_COPY[input.kind];
+  const fieldErrors: Record<string, string> = {};
+
+  if (subject.length > 200) {
+    fieldErrors.subject = "Keep the subject to 200 characters.";
+  } else if (/[\r\n]/.test(subject)) {
+    fieldErrors.subject = "A subject is one line.";
+  }
+
+  if (intro.length > 2000) {
+    fieldErrors.intro = "Keep the opening paragraph to 2,000 characters.";
+  }
+
+  for (const [field, text] of [
+    ["subject", subject],
+    ["intro", intro],
+  ] as const) {
+    const unknown = unknownPlaceholders(text);
+
+    if (unknown.length > 0 && !fieldErrors[field]) {
+      fieldErrors[field] =
+        `Unknown placeholder {{${unknown[0]!}}}. Use ${TEMPLATE_PLACEHOLDERS.map((name) => `{{${name}}}`).join(", ")}.`;
+    }
+  }
+
+  if (Object.keys(fieldErrors).length > 0) {
+    throw new TemplateValidationError(fieldErrors);
+  }
+
+  if (
+    (!subject && !intro) ||
+    (subject === defaults.subject && intro === defaults.intro)
+  ) {
+    await database.query(`DELETE FROM email_templates WHERE kind = $1`, [
+      input.kind,
+    ]);
+    return;
+  }
+
+  await database.query(
+    `
+      INSERT INTO email_templates (kind, subject, intro, updated_by_user_id, updated_at)
+      VALUES ($1, $2, $3, $4, $5)
+      ON CONFLICT (kind) DO UPDATE
+      SET subject = EXCLUDED.subject,
+          intro = EXCLUDED.intro,
+          updated_by_user_id = EXCLUDED.updated_by_user_id,
+          updated_at = EXCLUDED.updated_at
+    `,
+    [
+      input.kind,
+      subject || defaults.subject,
+      intro || defaults.intro,
+      userId,
+      Math.floor(Date.now() / 1000),
+    ],
+  );
+}
