+++ b/src/lib/email/accounts.ts
@@ -0,0 +1,1002 @@
+import { randomUUID } from "node:crypto";
+
+import { z } from "zod";
+
+import {
+  getDb,
+  queryMany,
+  queryOne,
+  withTransaction,
+  type DbExecutor,
+  type DbPool,
+} from "../db/connection.ts";
+import { emailSchema } from "../schemas/common.ts";
+import { type EnvSource } from "../utils/env.ts";
+import { openJson, sealJson } from "./crypto.ts";
+import {
+  getPreset,
+  PROVIDER_PRESET_IDS,
+  type AccountProvider,
+  type ProviderPresetId,
+  type SmtpSecurity,
+} from "./presets.ts";
+import { verifyResendApiKey } from "./resend.ts";
+import {
+  checkSmtpEndpoint,
+  normalizeSmtpHost,
+  verifySmtpSettings,
+  type SmtpSettings,
+  type SmtpTransportOptions,
+} from "./smtp.ts";
+import { EmailTransportError } from "./types.ts";
+
+// Connected mailboxes and who may do what with them.
+//
+// - A personal account is seen, used, changed and removed by its owner
+//   only. Nobody else's resolution ever considers it, administrators
+//   included.
+// - An organisation account is created, changed and removed by
+//   administrators only. It is used by the people it is shared with:
+//   nobody (then it only carries platform mail, as the default), everyone,
+//   or chosen teams.
+// - A person may prefer only an account they own or one shared with them.
+// - No view ever carries a password, API key or token.
+
+export type AccountScope = "organization" | "personal";
+export type AccountStatus = "connected" | "needs_reconnect" | "error";
+export type SharedWith = "nobody" | "everyone" | "teams";
+
+export type EmailAccountRecord = {
+  createdAt: number;
+  dailyLimit: number | null;
+  displayName: string | null;
+  emailAddress: string;
+  encryptedCredentials: string;
+  id: string;
+  isDefault: boolean;
+  lastError: string | null;
+  lastErrorAt: number | null;
+  lastSuccessAt: number | null;
+  oauthScope: string | null;
+  ownerUserId: string | null;
+  presetId: ProviderPresetId;
+  provider: AccountProvider;
+  providerAccountId: string | null;
+  replyTo: string | null;
+  scope: AccountScope;
+  sharedWith: SharedWith;
+  smtpHost: string | null;
+  smtpPort: number | null;
+  smtpSecurity: SmtpSecurity | null;
+  smtpUsername: string | null;
+  status: AccountStatus;
+  updatedAt: number;
+};
+
+export type StoredCredentials =
+  | { password: string; type: "password" }
+  | { apiKey: string; type: "api_key" }
+  | {
+      accessToken: string;
+      /** Unix seconds. */
+      expiresAt: number;
+      refreshToken: string | null;
+      scope: string;
+      type: "oauth";
+    };
+
+export type EmailAccountView = {
+  createdAt: number;
+  displayName: string | null;
+  emailAddress: string;
+  id: string;
+  isDefault: boolean;
+  lastError: string | null;
+  lastErrorAt: number | null;
+  lastSuccessAt: number | null;
+  ownedByMe: boolean;
+  presetId: ProviderPresetId;
+  provider: AccountProvider;
+  replyTo: string | null;
+  scope: AccountScope;
+  sharedWith: SharedWith;
+  smtp: {
+    host: string;
+    port: number;
+    security: SmtpSecurity;
+    username: string;
+  } | null;
+  status: AccountStatus;
+  teamIds: string[];
+};
+
+export class EmailAccountError extends Error {
+  readonly code: string | null;
+  readonly fieldErrors: Record<string, string> | null;
+  readonly statusCode: number;
+
+  constructor(
+    message: string,
+    statusCode: number,
+    {
+      code = null,
+      fieldErrors = null,
+    }: { code?: string | null; fieldErrors?: Record<string, string> | null } = {},
+  ) {
+    super(message);
+    this.name = "EmailAccountError";
+    this.code = code;
+    this.fieldErrors = fieldErrors;
+    this.statusCode = statusCode;
+  }
+}
+
+export const ACCOUNT_COLUMNS = `
+  a.id,
+  a.scope,
+  a.owner_user_id AS "ownerUserId",
+  a.provider,
+  a.preset_id AS "presetId",
+  a.email_address AS "emailAddress",
+  a.display_name AS "displayName",
+  a.reply_to AS "replyTo",
+  a.status,
+  a.encrypted_credentials AS "encryptedCredentials",
+  a.smtp_host AS "smtpHost",
+  a.smtp_port AS "smtpPort",
+  a.smtp_security AS "smtpSecurity",
+  a.smtp_username AS "smtpUsername",
+  a.provider_account_id AS "providerAccountId",
+  a.oauth_scope AS "oauthScope",
+  a.daily_limit AS "dailyLimit",
+  a.is_default AS "isDefault",
+  a.shared_with AS "sharedWith",
+  a.last_success_at AS "lastSuccessAt",
+  a.last_error AS "lastError",
+  a.last_error_at AS "lastErrorAt",
+  a.created_at AS "createdAt",
+  a.updated_at AS "updatedAt"
+`;
+
+/**
+ * The accounts a person may send through: their own, and organisation
+ * accounts shared with everyone or with a team they are on. $1 is the
+ * person's id. Nothing else is ever a candidate.
+ */
+export const USABLE_BY_USER = `
+  (
+    (a.scope = 'personal' AND a.owner_user_id = $1)
+    OR (
+      a.scope = 'organization'
+      AND (
+        a.shared_with = 'everyone'
+        OR (
+          a.shared_with = 'teams'
+          AND EXISTS (
+            SELECT 1
+            FROM email_account_teams t
+            JOIN team_members m ON m.team_id = t.team_id
+            WHERE t.account_id = a.id AND m.user_id = $1
+          )
+        )
+      )
+    )
+  )
+`;
+
+function now(): number {
+  return Math.floor(Date.now() / 1000);
+}
+
+export function credentialsContext(accountId: string): string {
+  return `email-account:${accountId}`;
+}
+
+export function sealCredentials(
+  accountId: string,
+  credentials: StoredCredentials,
+  env: EnvSource = process.env,
+): string {
+  return sealJson(credentials, { context: credentialsContext(accountId), env });
+}
+
+export function openCredentials(
+  account: Pick<EmailAccountRecord, "encryptedCredentials" | "id">,
+  env: EnvSource = process.env,
+): StoredCredentials {
+  return openJson<StoredCredentials>(account.encryptedCredentials, {
+    context: credentialsContext(account.id),
+    env,
+  });
+}
+
+export async function isAdministrator(
+  userId: string,
+  database: DbExecutor = getDb(),
+): Promise<boolean> {
+  const row = await queryOne<{ role: string | null }>(
+    database,
+    `SELECT role FROM public."user" WHERE id = $1`,
+    [userId],
+  );
+
+  return row?.role === "admin";
+}
+
+export async function loadAccount(
+  accountId: string,
+  database: DbExecutor = getDb(),
+): Promise<EmailAccountRecord | null> {
+  return queryOne<EmailAccountRecord>(
+    database,
+    `SELECT ${ACCOUNT_COLUMNS} FROM email_accounts a WHERE a.id = $1`,
+    [accountId],
+  );
+}
+
+/** The account, when this person may send through it. */
+export async function loadUsableAccount(
+  userId: string,
+  accountId: string,
+  database: DbExecutor = getDb(),
+): Promise<EmailAccountRecord | null> {
+  return queryOne<EmailAccountRecord>(
+    database,
+    `SELECT ${ACCOUNT_COLUMNS} FROM email_accounts a WHERE a.id = $2 AND ${USABLE_BY_USER}`,
+    [userId, accountId],
+  );
+}
+
+export async function canUseAccount(
+  userId: string,
+  accountId: string,
+  database: DbExecutor = getDb(),
+): Promise<boolean> {
+  return (await loadUsableAccount(userId, accountId, database)) !== null;
+}
+
+/** Personal accounts: their owner. Organisation accounts: administrators. */
+export async function canManageAccount(
+  userId: string,
+  account: Pick<EmailAccountRecord, "ownerUserId" | "scope">,
+  database: DbExecutor = getDb(),
+): Promise<boolean> {
+  return account.scope === "personal"
+    ? account.ownerUserId === userId
+    : isAdministrator(userId, database);
+}
+
+/**
+ * The account for someone who wants to change it or look at it closely.
+ * One they may not see is reported as missing, not as forbidden, so its
+ * existence is not given away.
+ */
+async function loadManagedAccount(
+  userId: string,
+  accountId: string,
+  database: DbExecutor,
+): Promise<EmailAccountRecord> {
+  const account = await loadAccount(accountId, database);
+
+  if (!account || !(await canManageAccount(userId, account, database))) {
+    if (account?.scope === "organization") {
+      throw new EmailAccountError(
+        "Only an administrator can change organisation email accounts.",
+        403,
+      );
+    }
+
+    throw new EmailAccountError("That email account no longer exists.", 404);
+  }
+
+  return account;
+}
+
+async function listTeamIds(
+  accountIds: readonly string[],
+  database: DbExecutor,
+): Promise<Map<string, string[]>> {
+  const rows =
+    accountIds.length === 0
+      ? []
+      : await queryMany<{ accountId: string; teamId: string }>(
+          database,
+          `
+            SELECT account_id AS "accountId", team_id AS "teamId"
+            FROM email_account_teams
+            WHERE account_id = ANY($1::text[])
+            ORDER BY team_id
+          `,
+          [accountIds],
+        );
+  const byAccount = new Map<string, string[]>();
+
+  for (const row of rows) {
+    byAccount.set(row.accountId, [
+      ...(byAccount.get(row.accountId) ?? []),
+      row.teamId,
+    ]);
+  }
+
+  return byAccount;
+}
+
+export function toAccountView(
+  account: EmailAccountRecord,
+  userId: string,
+  teamIds: string[] = [],
+): EmailAccountView {
+  return {
+    createdAt: account.createdAt,
+    displayName: account.displayName,
+    emailAddress: account.emailAddress,
+    id: account.id,
+    isDefault: account.isDefault,
+    lastError: account.lastError,
+    lastErrorAt: account.lastErrorAt,
+    lastSuccessAt: account.lastSuccessAt,
+    ownedByMe: account.scope === "personal" && account.ownerUserId === userId,
+    presetId: account.presetId,
+    provider: account.provider,
+    replyTo: account.replyTo,
+    scope: account.scope,
+    sharedWith: account.sharedWith,
+    smtp:
+      account.provider === "smtp" &&
+      account.smtpHost &&
+      account.smtpPort &&
+      account.smtpSecurity
+        ? {
+            host: account.smtpHost,
+            port: account.smtpPort,
+            security: account.smtpSecurity,
+            username: account.smtpUsername ?? "",
+          }
+        : null,
+    status: account.status,
+    teamIds,
+  };
+}
+
+/**
+ * What a person sees in Settings > Email & Integrations: their own
+ * accounts, and the organisation's (all of them for an administrator, the
+ * ones shared with them otherwise).
+ */
+export async function listVisibleAccounts(
+  userId: string,
+  database: DbExecutor = getDb(),
+): Promise<{
+  accounts: EmailAccountView[];
+  canManageOrganization: boolean;
+  preferredAccountId: string | null;
+}> {
+  const admin = await isAdministrator(userId, database);
+  const rows = await queryMany<EmailAccountRecord>(
+    database,
+    `
+      SELECT ${ACCOUNT_COLUMNS}
+      FROM email_accounts a
+      WHERE ${admin ? `(a.scope = 'organization' OR (a.scope = 'personal' AND a.owner_user_id = $1))` : USABLE_BY_USER}
+      ORDER BY a.scope, a.is_default DESC, lower(a.email_address), a.id
+    `,
+    [userId],
+  );
+  const teamIds = await listTeamIds(
+    rows.map((row) => row.id),
+    database,
+  );
+
+  return {
+    accounts: rows.map((row) =>
+      toAccountView(row, userId, teamIds.get(row.id) ?? []),
+    ),
+    canManageOrganization: admin,
+    preferredAccountId: await getPreferredAccountId(userId, database),
+  };
+}
+
+/** The account a person prefers, while they may still use it. */
+export async function getPreferredAccountId(
+  userId: string,
+  database: DbExecutor = getDb(),
+): Promise<string | null> {
+  const row = await queryOne<{ accountId: string }>(
+    database,
+    `
+      SELECT p.account_id AS "accountId"
+      FROM email_account_preferences p
+      JOIN email_accounts a ON a.id = p.account_id
+      WHERE p.user_id = $1 AND ${USABLE_BY_USER}
+    `,
+    [userId],
+  );
+
+  return row?.accountId ?? null;
+}
+
+export async function setPreferredAccount(
+  userId: string,
+  accountId: string | null,
+  database: DbExecutor = getDb(),
+): Promise<void> {
+  if (accountId === null) {
+    await database.query(
+      `DELETE FROM email_account_preferences WHERE user_id = $1`,
+      [userId],
+    );
+    return;
+  }
+
+  if (!(await canUseAccount(userId, accountId, database))) {
+    throw new EmailAccountError(
+      "You can only choose an account you connected or one shared with you.",
+      404,
+    );
+  }
+
+  await database.query(
+    `
+      INSERT INTO email_account_preferences (user_id, account_id, updated_at)
+      VALUES ($1, $2, $3)
+      ON CONFLICT (user_id) DO UPDATE
+      SET account_id = EXCLUDED.account_id, updated_at = EXCLUDED.updated_at
+    `,
+    [userId, accountId, now()],
+  );
+}
+
+// --- Creating and changing accounts ---------------------------------------
+
+const optionalText = (max: number) =>
+  z
+    .string()
+    .trim()
+    .max(max)
+    .nullish()
+    .transform((value) => (value ? value : null));
+
+const optionalEmail = z
+  .union([emailSchema, z.literal("")])
+  .nullish()
+  .transform((value) => (value ? value.toLowerCase() : null));
+
+export const createAccountSchema = z.object({
+  apiKey: z.string().trim().min(1).max(512).optional(),
+  dailyLimit: z.number().int().positive().max(1_000_000).nullish(),
+  displayName: optionalText(120),
+  emailAddress: emailSchema.transform((value) => value.toLowerCase()),
+  host: z.string().trim().max(253).optional(),
+  isDefault: z.boolean().optional(),
+  password: z.string().min(1).max(1024).optional(),
+  port: z.number().int().optional(),
+  presetId: z.enum(PROVIDER_PRESET_IDS),
+  replyTo: optionalEmail,
+  scope: z.enum(["organization", "personal"]),
+  security: z.enum(["tls", "starttls"]).optional(),
+  sharedWith: z.enum(["nobody", "everyone", "teams"]).optional(),
+  teamIds: z.array(z.string().min(1).max(100)).max(200).optional(),
+  username: z.string().trim().max(320).optional(),
+});
+
+export type CreateAccountInput = z.input<typeof createAccountSchema>;
+
+export const updateAccountSchema = z.object({
+  dailyLimit: z.number().int().positive().max(1_000_000).nullish(),
+  displayName: optionalText(120).optional(),
+  isDefault: z.boolean().optional(),
+  password: z.string().min(1).max(1024).optional(),
+  replyTo: optionalEmail.optional(),
+  sharedWith: z.enum(["nobody", "everyone", "teams"]).optional(),
+  teamIds: z.array(z.string().min(1).max(100)).max(200).optional(),
+});
+
+export type UpdateAccountInput = z.input<typeof updateAccountSchema>;
+
+export function fieldErrorsOf(error: z.ZodError): Record<string, string> {
+  const fieldErrors: Record<string, string> = {};
+
+  for (const issue of error.issues) {
+    const field = issue.path.join(".") || "body";
+
+    fieldErrors[field] ??= issue.message;
+  }
+
+  return fieldErrors;
+}
+
+function parse<T extends z.ZodType>(schema: T, input: unknown): z.output<T> {
+  const parsed = schema.safeParse(input);
+
+  if (!parsed.success) {
+    const fieldErrors = fieldErrorsOf(parsed.error);
+
+    throw new EmailAccountError("Check the highlighted fields.", 400, {
+      fieldErrors,
+    });
+  }
+
+  return parsed.data;
+}
+
+export type AccountOptions = {
+  database?: DbPool;
+  env?: EnvSource;
+  /** Passed to the SMTP check, so a test can trust its own server. */
+  smtp?: SmtpTransportOptions;
+  /** Replaced in tests that must not reach Resend. */
+  verifyResendKey?: (apiKey: string) => Promise<void>;
+};
+
+function verificationFailed(error: unknown, field: string): EmailAccountError {
+  const message =
+    error instanceof Error && error.message
+      ? error.message
+      : "The account could not be verified.";
+
+  return new EmailAccountError(message, 422, {
+    code:
+      error instanceof EmailTransportError && error.kind === "auth"
+        ? "authentication_failed"
+        : "verification_failed",
+    fieldErrors: { [field]: message },
+  });
+}
+
+async function assertTeamsExist(
+  teamIds: readonly string[],
+  database: DbExecutor,
+): Promise<void> {
+  if (teamIds.length === 0) {
+    throw new EmailAccountError("Choose at least one team.", 400, {
+      fieldErrors: { teamIds: "Choose at least one team." },
+    });
+  }
+
+  const found = await queryMany<{ id: string }>(
+    database,
+    `SELECT id FROM teams WHERE id = ANY($1::text[])`,
+    [teamIds],
+  );
+
+  if (found.length !== new Set(teamIds).size) {
+    throw new EmailAccountError("One of those teams no longer exists.", 400, {
+      fieldErrors: { teamIds: "One of those teams no longer exists." },
+    });
+  }
+}
+
+async function replaceTeams(
+  accountId: string,
+  teamIds: readonly string[],
+  database: DbExecutor,
+): Promise<void> {
+  await database.query(`DELETE FROM email_account_teams WHERE account_id = $1`, [
+    accountId,
+  ]);
+
+  for (const teamId of new Set(teamIds)) {
+    await database.query(
+      `INSERT INTO email_account_teams (account_id, team_id) VALUES ($1, $2)`,
+      [accountId, teamId],
+    );
+  }
+}
+
+/** The SMTP settings to use for a preset, from what was entered. */
+export function resolveSmtpInput(
+  presetId: ProviderPresetId,
+  input: {
+    emailAddress: string;
+    host?: string;
+    password?: string;
+    port?: number;
+    security?: SmtpSecurity;
+    username?: string;
+  },
+): SmtpSettings {
+  const preset = getPreset(presetId);
+  const fieldErrors: Record<string, string> = {};
+  let host: string;
+  let port: number;
+  let security: SmtpSecurity;
+
+  if (preset.smtpDefaults) {
+    const chosenHost = input.host ? normalizeSmtpHost(input.host) : null;
+
+    if (chosenHost && !preset.smtpHosts.includes(chosenHost)) {
+      fieldErrors.host = `${preset.name} uses ${preset.smtpHosts.join(" or ")}.`;
+    }
+
+    host = chosenHost ?? preset.smtpDefaults.host;
+    port = preset.smtpDefaults.port;
+    security = preset.smtpDefaults.security;
+  } else {
+    host = normalizeSmtpHost(input.host ?? "");
+    port = input.port ?? 587;
+    security = input.security ?? (port === 465 ? "tls" : "starttls");
+    Object.assign(fieldErrors, checkSmtpEndpoint({ host, port, security }));
+  }
+
+  const username = preset.usernameIsAddress
+    ? input.emailAddress
+    : (input.username?.trim() || input.emailAddress);
+
+  if (!input.password) {
+    fieldErrors.password = preset.appPasswordRequired
+      ? `Enter an app password for ${preset.name}. Your normal password does not work here.`
+      : "Enter the password.";
+  }
+
+  if (Object.keys(fieldErrors).length > 0) {
+    throw new EmailAccountError("Check the highlighted fields.", 400, {
+      fieldErrors,
+    });
+  }
+
+  return { host, password: input.password!, port, security, username };
+}
+
+function isUniqueViolation(error: unknown): boolean {
+  return (error as { code?: unknown } | null)?.code === "23505";
+}
+
+export type AccountActor = { email: string; name: string; userId: string };
+
+/**
+ * Connects an SMTP or Resend account. The credentials are tried first, for
+ * real: nothing is saved that does not sign in.
+ */
+export async function createAccount(
+  actor: AccountActor,
+  rawInput: unknown,
+  {
+    database = getDb(),
+    env = process.env,
+    smtp,
+    verifyResendKey = (apiKey) => verifyResendApiKey(apiKey),
+  }: AccountOptions = {},
+): Promise<EmailAccountView> {
+  const input = parse(createAccountSchema, rawInput);
+  const preset = getPreset(input.presetId);
+
+  if (preset.method === "oauth") {
+    throw new EmailAccountError(
+      `Connect ${preset.name} with the "Connect with ${preset.oauth === "google" ? "Google" : "Microsoft"}" button. PACTORA never asks for a ${preset.oauth === "google" ? "Google" : "Microsoft"} password.`,
+      400,
+      { code: "oauth_required", fieldErrors: { presetId: "Use the sign-in button for this provider." } },
+    );
+  }
+
+  const admin = await isAdministrator(actor.userId, database);
+
+  if (input.scope === "organization" && !admin) {
+    throw new EmailAccountError(
+      "Only an administrator can connect an organisation email account.",
+      403,
+    );
+  }
+
+  if (input.scope === "personal" && (input.isDefault || (input.sharedWith && input.sharedWith !== "nobody"))) {
+    throw new EmailAccountError(
+      "A personal account is only ever yours: it cannot be shared or be the organisation's default.",
+      400,
+      { fieldErrors: { sharedWith: "Personal accounts are not shared." } },
+    );
+  }
+
+  const sharedWith = input.scope === "organization" ? (input.sharedWith ?? "nobody") : "nobody";
+
+  if (sharedWith === "teams") {
+    await assertTeamsExist(input.teamIds ?? [], database);
+  }
+
+  const id = randomUUID();
+  let credentials: StoredCredentials;
+  let smtpSettings: SmtpSettings | null = null;
+
+  if (preset.provider === "resend") {
+    if (!input.apiKey) {
+      throw new EmailAccountError("Enter the Resend API key.", 400, {
+        fieldErrors: { apiKey: "Enter the Resend API key." },
+      });
+    }
+
+    try {
+      await verifyResendKey(input.apiKey);
+    } catch (error) {
+      throw verificationFailed(error, "apiKey");
+    }
+
+    credentials = { apiKey: input.apiKey, type: "api_key" };
+  } else {
+    smtpSettings = resolveSmtpInput(input.presetId, {
+      emailAddress: input.emailAddress,
+      host: input.host,
+      password: input.password,
+      port: input.port,
+      security: input.security,
+      username: input.username,
+    });
+
+    try {
+      await verifySmtpSettings(smtpSettings, { env, ...smtp });
+    } catch (error) {
+      throw verificationFailed(error, "password");
+    }
+
+    credentials = { password: smtpSettings.password, type: "password" };
+  }
+
+  const timestamp = now();
+
+  try {
+    await withTransaction(async (tx) => {
+      if (input.isDefault) {
+        await tx.query(
+          `UPDATE email_accounts SET is_default = false, updated_at = $1 WHERE is_default`,
+          [timestamp],
+        );
+      }
+
+      await tx.query(
+        `
+          INSERT INTO email_accounts (
+            id, scope, owner_user_id, created_by_user_id, provider, preset_id,
+            email_address, display_name, reply_to, status,
+            encrypted_credentials, smtp_host, smtp_port, smtp_security,
+            smtp_username, daily_limit, is_default, shared_with,
+            last_success_at, created_at, updated_at
+          )
+          VALUES (
+            $1, $2, $3, $4, $5, $6, $7, $8, $9, 'connected', $10, $11, $12,
+            $13, $14, $15, $16, $17, $18, $18, $18
+          )
+        `,
+        [
+          id,
+          input.scope,
+          input.scope === "personal" ? actor.userId : null,
+          actor.userId,
+          preset.provider,
+          preset.id,
+          input.emailAddress,
+          input.displayName,
+          input.replyTo,
+          sealCredentials(id, credentials, env),
+          smtpSettings?.host ?? null,
+          smtpSettings?.port ?? null,
+          smtpSettings?.security ?? null,
+          smtpSettings?.username ?? null,
+          input.dailyLimit ?? null,
+          input.scope === "organization" && Boolean(input.isDefault),
+          sharedWith,
+          timestamp,
+        ],
+      );
+
+      if (sharedWith === "teams") {
+        await replaceTeams(id, input.teamIds ?? [], tx);
+      }
+    }, database);
+  } catch (error) {
+    if (isUniqueViolation(error)) {
+      throw new EmailAccountError(
+        `${input.emailAddress} is already connected.`,
+        409,
+        { code: "already_connected", fieldErrors: { emailAddress: "Already connected." } },
+      );
+    }
+
+    throw error;
+  }
+
+  const created = (await loadAccount(id, database))!;
+
+  return toAccountView(created, actor.userId, sharedWith === "teams" ? [...new Set(input.teamIds)].sort() : []);
+}
+
+export async function updateAccount(
+  actor: AccountActor,
+  accountId: string,
+  rawInput: unknown,
+  { database = getDb(), env = process.env, smtp }: AccountOptions = {},
+): Promise<EmailAccountView> {
+  const input = parse(updateAccountSchema, rawInput);
+  const account = await loadManagedAccount(actor.userId, accountId, database);
+  const timestamp = now();
+
+  if (
+    account.scope === "personal" &&
+    (input.isDefault || (input.sharedWith && input.sharedWith !== "nobody") || input.teamIds)
+  ) {
+    throw new EmailAccountError(
+      "A personal account is only ever yours: it cannot be shared or be the organisation's default.",
+      400,
+      { fieldErrors: { sharedWith: "Personal accounts are not shared." } },
+    );
+  }
+
+  const sharedWith = input.sharedWith ?? account.sharedWith;
+
+  if (sharedWith === "teams" && (input.sharedWith === "teams" || input.teamIds)) {
+    await assertTeamsExist(input.teamIds ?? (await listTeamIds([account.id], database)).get(account.id) ?? [], database);
+  }
+
+  let encryptedCredentials = account.encryptedCredentials;
+  let status = account.status;
+
+  if (input.password !== undefined) {
+    if (account.provider !== "smtp") {
+      throw new EmailAccountError(
+        "Only an SMTP account has a password. Reconnect this account instead.",
+        400,
+        { fieldErrors: { password: "This account does not use a password." } },
+      );
+    }
+
+    const settings: SmtpSettings = {
+      host: account.smtpHost ?? "",
+      password: input.password,
+      port: account.smtpPort ?? 0,
+      security: account.smtpSecurity ?? "starttls",
+      username: account.smtpUsername ?? account.emailAddress,
+    };
+
+    try {
+      await verifySmtpSettings(settings, { env, ...smtp });
+    } catch (error) {
+      throw verificationFailed(error, "password");
+    }
+
+    encryptedCredentials = sealCredentials(
+      account.id,
+      { password: input.password, type: "password" },
+      env,
+    );
+    status = "connected";
+  }
+
+  await withTransaction(async (tx) => {
+    if (input.isDefault === true) {
+      await tx.query(
+        `UPDATE email_accounts SET is_default = false, updated_at = $1 WHERE is_default AND id <> $2`,
+        [timestamp, account.id],
+      );
+    }
+
+    await tx.query(
+      `
+        UPDATE email_accounts
+        SET display_name = $2,
+            reply_to = $3,
+            is_default = $4,
+            shared_with = $5,
+            encrypted_credentials = $6,
+            status = $7,
+            daily_limit = $8,
+            last_error = CASE WHEN $7 = 'connected' AND status <> 'connected' THEN NULL ELSE last_error END,
+            updated_at = $9
+        WHERE id = $1
+      `,
+      [
+        account.id,
+        input.displayName === undefined ? account.displayName : input.displayName,
+        input.replyTo === undefined ? account.replyTo : input.replyTo,
+        input.isDefault ?? account.isDefault,
+        sharedWith,
+        encryptedCredentials,
+        status,
+        input.dailyLimit === undefined ? account.dailyLimit : input.dailyLimit,
+        timestamp,
+      ],
+    );
+
+    if (sharedWith !== "teams") {
+      await tx.query(`DELETE FROM email_account_teams WHERE account_id = $1`, [
+        account.id,
+      ]);
+    } else if (input.teamIds) {
+      await replaceTeams(account.id, input.teamIds, tx);
+    }
+
+    // Shared more narrowly: whoever can no longer use it stops preferring it.
+    await tx.query(
+      `
+        DELETE FROM email_account_preferences p
+        USING email_accounts a
+        WHERE p.account_id = $1 AND a.id = p.account_id
+          AND NOT ${USABLE_BY_USER.replaceAll("$1", "p.user_id")}
+      `,
+      [account.id],
+    );
+  }, database);
+
+  const updated = (await loadAccount(account.id, database))!;
+  const teamIds = await listTeamIds([account.id], database);
+
+  return toAccountView(updated, actor.userId, teamIds.get(account.id) ?? []);
+}
+
+/** Removes the account. Revoking an OAuth grant is the caller's (oauth.ts). */
+export async function deleteAccountRow(
+  actor: AccountActor,
+  accountId: string,
+  database: DbPool = getDb(),
+): Promise<EmailAccountRecord> {
+  const account = await loadManagedAccount(actor.userId, accountId, database);
+
+  await database.query(`DELETE FROM email_accounts WHERE id = $1`, [account.id]);
+
+  return account;
+}
+
+/** The account for someone who may manage it, or an EmailAccountError. */
+export async function requireManagedAccount(
+  userId: string,
+  accountId: string,
+  database: DbExecutor = getDb(),
+): Promise<EmailAccountRecord> {
+  return loadManagedAccount(userId, accountId, database);
+}
+
+/** Notes how the account's last send went, for Settings. */
+export async function recordAccountOutcome(
+  accountId: string,
+  outcome:
+    | { ok: true }
+    | { error: string; needsReconnect?: boolean; ok: false },
+  database: DbExecutor = getDb(),
+): Promise<void> {
+  const timestamp = now();
+
+  if (outcome.ok) {
+    await database.query(
+      `
+        UPDATE email_accounts
+        SET last_success_at = $2,
+            status = CASE WHEN status = 'error' THEN 'connected' ELSE status END,
+            updated_at = $2
+        WHERE id = $1
+      `,
+      [accountId, timestamp],
+    );
+    return;
+  }
+
+  await database.query(
+    `
+      UPDATE email_accounts
+      SET last_error = $2,
+          last_error_at = $3,
+          status = CASE WHEN $4 THEN 'needs_reconnect' ELSE status END,
+          updated_at = $3
+      WHERE id = $1
+    `,
+    [accountId, outcome.error.slice(0, 1000), timestamp, Boolean(outcome.needsReconnect)],
+  );
+}
+
+export async function saveAccountCredentials(
+  accountId: string,
+  credentials: StoredCredentials,
+  {
+    database = getDb(),
+    env = process.env,
+  }: { database?: DbExecutor; env?: EnvSource } = {},
+): Promise<void> {
+  await database.query(
+    `UPDATE email_accounts SET encrypted_credentials = $2, updated_at = $3 WHERE id = $1`,
+    [accountId, sealCredentials(accountId, credentials, env), now()],
+  );
+}
+
+/** The workspace's default organisation account, if there is one. */
+export async function loadDefaultAccount(
+  database: DbExecutor = getDb(),
+): Promise<EmailAccountRecord | null> {
+  return queryOne<EmailAccountRecord>(
+    database,
+    `SELECT ${ACCOUNT_COLUMNS} FROM email_accounts a WHERE a.is_default AND a.scope = 'organization'`,
+  );
+}
diff --git a/src/lib/email/capture.ts b/src/lib/email/capture.ts
new file mode 100644
index 0000000..4813594
--- /dev/null
+++ b/src/lib/email/capture.ts
@@ -0,0 +1,110 @@
+import { createHash, randomUUID } from "node:crypto";
+import { mkdir, rename, writeFile } from "node:fs/promises";
+import path from "node:path";
+
+import { CAPTURED_MESSAGE_ID_PREFIX } from "../services/captured-email.ts";
+import {
+  isLocalDeployment,
+  readEnv,
+  type EnvSource,
+} from "../utils/env.ts";
+import { buildResendPayload } from "./resend.ts";
+import { type EmailTransport, type OutgoingMessage } from "./types.ts";
+
+// Development and test driver (EMAIL_DRIVER=capture): nothing is sent.
+// Each message is written as a JSON file so a person, or the end-to-end
+// test, can read the links in it. Never allowed on Vercel or on a deployed
+// production site, because it drops every email.
+
+const DEFAULT_CAPTURE_DIR = ".data/outbox";
+
+export const CAPTURE_IN_PRODUCTION_ERROR_MESSAGE =
+  "EMAIL_DRIVER=capture drops every email and cannot be used in production.";
+
+/**
+ * Whether EMAIL_DRIVER=capture may be used in this deployment.
+ * Allowed in development, and for a production build that is being run on
+ * localhost (which is what the end-to-end test does). Never on Vercel or on
+ * a deployed production site.
+ */
+export function isCaptureEmailDriverAllowed(
+  env: EnvSource = process.env,
+): boolean {
+  if (readEnv(env, "VERCEL") === "1") {
+    return false;
+  }
+
+  if (env.NODE_ENV !== "production") {
+    return true;
+  }
+
+  try {
+    return isLocalDeployment(env);
+  } catch {
+    return false;
+  }
+}
+
+export function createCaptureTransport(
+  env: EnvSource = process.env,
+): EmailTransport {
+  if (!isCaptureEmailDriverAllowed(env)) {
+    throw new Error(CAPTURE_IN_PRODUCTION_ERROR_MESSAGE);
+  }
+
+  // The comment stops Turbopack from tracing the whole project into the
+  // server bundle because of a path it cannot analyse.
+  const captureDir = path.resolve(
+    /*turbopackIgnore: true*/ env.EMAIL_CAPTURE_DIR?.trim() ||
+      DEFAULT_CAPTURE_DIR,
+  );
+
+  return {
+    // Nothing leaves the machine, so anything fits.
+    maxAttachmentBytes: Number.MAX_SAFE_INTEGER,
+    provider: "capture",
+    async send(message: OutgoingMessage) {
+      const messageId = `${CAPTURED_MESSAGE_ID_PREFIX}${randomUUID()}`;
+      const filePath = path.join(
+        /*turbopackIgnore: true*/ captureDir,
+        `${String(Date.now())}-${messageId}.json`,
+      );
+      const temporaryPath = `${filePath}.tmp`;
+
+      // Written under a temporary name and renamed, so anything watching
+      // the outbox never reads a half-written file.
+      await mkdir(captureDir, { recursive: true });
+      await writeFile(
+        temporaryPath,
+        JSON.stringify(
+          {
+            ...buildResendPayload({ ...message, attachments: [] }),
+            // The files themselves are not written out; their names, sizes
+            // and fingerprints are enough to check what would have been sent.
+            attachments: message.attachments.length
+              ? message.attachments.map((attachment) => ({
+                  bytes: attachment.content.byteLength,
+                  contentType: attachment.contentType,
+                  filename: attachment.filename,
+                  sha256: createHash("sha256")
+                    .update(attachment.content)
+                    .digest("hex"),
+                }))
+              : undefined,
+            capturedAt: new Date().toISOString(),
+            messageId,
+            template: message.template,
+          },
+          null,
+          2,
+        ),
+      );
+      await rename(temporaryPath, filePath);
+      console.info(
+        `[email:capture] ${message.template} to ${message.to} -> ${filePath}`,
+      );
+
+      return { providerMessageId: messageId };
+    },
+  };
+}
diff --git a/src/lib/email/classify.ts b/src/lib/email/classify.ts
new file mode 100644
index 0000000..f52c655
--- /dev/null
+++ b/src/lib/email/classify.ts
@@ -0,0 +1,118 @@
+import { EmailTransportError, type DeliveryFailureKind } from "./types.ts";
+
+// Whether a failed send is worth trying again. Everything a transport
+// throws passes through here, so the rest of the engine only sees
+// EmailTransportError with a kind.
+
+const NETWORK_CODES = new Set([
+  "ECONNECTION",
+  "ECONNREFUSED",
+  "ECONNRESET",
+  "EDNS",
+  "EAI_AGAIN",
+  "ENETUNREACH",
+  "EHOSTUNREACH",
+  "EPIPE",
+  "ESOCKET",
+  "ETIMEDOUT",
+  "UND_ERR_CONNECT_TIMEOUT",
+  "UND_ERR_SOCKET",
+]);
+
+/** For an HTTP API: 429 and 5xx pass, 401/403 are the credentials. */
+export function kindForHttpStatus(status: number): DeliveryFailureKind {
+  if (status === 429 || status >= 500 || status === 408) {
+    return "transient";
+  }
+
+  return status === 401 || status === 403 ? "auth" : "permanent";
+}
+
+function readProperty(error: unknown, name: string): unknown {
+  return typeof error === "object" && error !== null && name in error
+    ? (error as Record<string, unknown>)[name]
+    : undefined;
+}
+
+/** The kind of a failure nodemailer reported for an SMTP conversation. */
+export function kindForSmtpError(error: unknown): DeliveryFailureKind {
+  const code = readProperty(error, "code");
+  const responseCode = readProperty(error, "responseCode");
+
+  if (code === "EAUTH" || responseCode === 535 || responseCode === 534) {
+    return "auth";
+  }
+
+  if (typeof responseCode === "number") {
+    if (responseCode >= 400 && responseCode < 500) {
+      return "transient";
+    }
+
+    if (responseCode >= 500) {
+      return "permanent";
+    }
+  }
+
+  if (typeof code === "string" && NETWORK_CODES.has(code)) {
+    return "transient";
+  }
+
+  const causeCode = readProperty(readProperty(error, "cause"), "code");
+
+  if (typeof causeCode === "string" && NETWORK_CODES.has(causeCode)) {
+    return "transient";
+  }
+
+  // A certificate that does not verify, a server without TLS, a message
+  // the server cannot take: none of these fix themselves.
+  return "permanent";
+}
+
+/** Any thrown value as an EmailTransportError. */
+export function toTransportError(error: unknown): EmailTransportError {
+  if (error instanceof EmailTransportError) {
+    return error;
+  }
+
+  const code = readProperty(error, "code");
+  const kind =
+    typeof code === "string" && NETWORK_CODES.has(code)
+      ? "transient"
+      : error instanceof TypeError && /fetch failed/i.test(error.message)
+        ? "transient"
+        : "permanent";
+
+  return new EmailTransportError(
+    error instanceof Error && error.message
+      ? error.message
+      : "Email delivery failed.",
+    { code: typeof code === "string" ? code : null, kind },
+  );
+}
+
+/**
+ * A fetch that threw never got an answer (no connection, a timeout), so
+ * nothing was sent and it is worth trying again.
+ */
+export function fetchFailure(
+  error: unknown,
+  service: string,
+): EmailTransportError {
+  const timedOut =
+    error instanceof Error &&
+    (error.name === "TimeoutError" || error.name === "AbortError");
+
+  return new EmailTransportError(
+    timedOut
+      ? `${service} did not answer in time.`
+      : `${service} could not be reached.`,
+    { code: timedOut ? "ETIMEDOUT" : "ECONNECTION", kind: "transient" },
+  );
+}
+
+/** Retry-After in milliseconds, when the header is a number of seconds. */
+export function retryAfterMs(header: string | null | undefined): number | null {
+  const seconds = Number(header);
+
+  return Number.isFinite(seconds) && seconds > 0 ? seconds * 1000 : null;
+}
diff --git a/src/lib/email/crypto.ts b/src/lib/email/crypto.ts
new file mode 100644
index 0000000..b1637fb
--- /dev/null
+++ b/src/lib/email/crypto.ts
@@ -0,0 +1,170 @@
+import {
+  createCipheriv,
+  createDecipheriv,
+  createHash,
+  hkdfSync,
+  randomBytes,
+} from "node:crypto";
+
+import {
+  isProduction,
+  readEnv,
+  resolveAuthSecret,
+  type EnvSource,
+} from "../utils/env.ts";
+
+// Mailbox credentials (passwords, API keys, OAuth tokens) and pending
+// message payloads are kept in the database encrypted with AES-256-GCM.
+//
+// The key is EMAIL_CREDENTIALS_KEY when set (32 bytes, hex or base64), so
+// it can be rotated apart from the auth secret. Otherwise it is derived
+// from the auth secret with HKDF-SHA256 for this purpose only.
+//
+// A sealed value reads "ec1.<key id>.<iv>.<tag>.<ciphertext>", base64url.
+// The key id is a short fingerprint of the key, so a value sealed under a
+// key that has since changed is told apart from one that was tampered with.
+// Each value is bound to what it belongs to (additional authenticated
+// data), so a ciphertext copied onto another row does not open there.
+
+const KEY_CONTEXT = "pactora/email-credentials/v1";
+const FORMAT_VERSION = "ec1";
+
+export class EmailCredentialsError extends Error {
+  readonly reason: "malformed" | "other_key" | "tampered";
+
+  constructor(reason: "malformed" | "other_key" | "tampered") {
+    super(
+      reason === "other_key"
+        ? "These credentials were saved under a different encryption key. Reconnect the account."
+        : "These credentials could not be read. Reconnect the account.",
+    );
+    this.name = "EmailCredentialsError";
+    this.reason = reason;
+  }
+}
+
+function parseConfiguredKey(value: string): Buffer {
+  if (/^[0-9a-f]{64}$/i.test(value)) {
+    return Buffer.from(value, "hex");
+  }
+
+  const decoded = Buffer.from(value, "base64");
+
+  if (decoded.byteLength === 32) {
+    return decoded;
+  }
+
+  throw new Error(
+    "EMAIL_CREDENTIALS_KEY must be 32 bytes, written as 64 hex characters or in base64.",
+  );
+}
+
+/** The key mailbox credentials are sealed with. */
+export function resolveCredentialsKey(env: EnvSource = process.env): Buffer {
+  const configured = readEnv(env, "EMAIL_CREDENTIALS_KEY");
+
+  if (configured) {
+    return parseConfiguredKey(configured);
+  }
+
+  const secret = resolveAuthSecret(env);
+
+  if (!secret) {
+    if (isProduction(env)) {
+      throw new Error(
+        "Saving email credentials needs EMAIL_CREDENTIALS_KEY or BETTER_AUTH_SECRET.",
+      );
+    }
+
+    // Local development without any secret: nothing worth protecting.
+    return Buffer.from(
+      hkdfSync("sha256", "pactora-development", "", KEY_CONTEXT, 32),
+    );
+  }
+
+  return Buffer.from(hkdfSync("sha256", secret, "", KEY_CONTEXT, 32));
+}
+
+function keyId(key: Buffer): string {
+  return createHash("sha256").update(key).digest("base64url").slice(0, 8);
+}
+
+type SealOptions = {
+  /** What the value belongs to, such as "email-account:<id>". */
+  context: string;
+  env?: EnvSource;
+  key?: Buffer;
+};
+
+export function sealSecret(
+  plaintext: string,
+  { context, env, key = resolveCredentialsKey(env) }: SealOptions,
+): string {
+  const iv = randomBytes(12);
+  const cipher = createCipheriv("aes-256-gcm", key, iv);
+
+  cipher.setAAD(Buffer.from(context, "utf8"));
+
+  const body = Buffer.concat([cipher.update(plaintext, "utf8"), cipher.final()]);
+
+  return [
+    FORMAT_VERSION,
+    keyId(key),
+    iv.toString("base64url"),
+    cipher.getAuthTag().toString("base64url"),
+    body.toString("base64url"),
+  ].join(".");
+}
+
+/** The plaintext, or an EmailCredentialsError saying why it cannot be had. */
+export function openSecret(
+  sealed: string,
+  { context, env, key = resolveCredentialsKey(env) }: SealOptions,
+): string {
+  const parts = sealed.split(".");
+
+  if (parts.length !== 5 || parts[0] !== FORMAT_VERSION) {
+    throw new EmailCredentialsError("malformed");
+  }
+
+  const [, sealedKeyId, iv, tag, body] = parts as [
+    string,
+    string,
+    string,
+    string,
+    string,
+  ];
+
+  if (sealedKeyId !== keyId(key)) {
+    throw new EmailCredentialsError("other_key");
+  }
+
+  try {
+    // The tag length is fixed, so a shortened tag is refused rather than
+    // checked on fewer bytes.
+    const decipher = createDecipheriv(
+      "aes-256-gcm",
+      key,
+      Buffer.from(iv, "base64url"),
+      { authTagLength: 16 },
+    );
+
+    decipher.setAAD(Buffer.from(context, "utf8"));
+    decipher.setAuthTag(Buffer.from(tag, "base64url"));
+
+    return Buffer.concat([
+      decipher.update(Buffer.from(body, "base64url")),
+      decipher.final(),
+    ]).toString("utf8");
+  } catch {
+    throw new EmailCredentialsError("tampered");
+  }
+}
+
+export function sealJson(value: unknown, options: SealOptions): string {
+  return sealSecret(JSON.stringify(value), options);
+}
+
+export function openJson<T>(sealed: string, options: SealOptions): T {
+  return JSON.parse(openSecret(sealed, options)) as T;
+}
diff --git a/src/lib/email/gmail.ts b/src/lib/email/gmail.ts
new file mode 100644
index 0000000..6ffb7cd
--- /dev/null
+++ b/src/lib/email/gmail.ts
@@ -0,0 +1,86 @@
+import { fetchFailure, kindForHttpStatus, retryAfterMs } from "./classify.ts";
+import { buildRawMime } from "./mime.ts";
+import {
+  EmailTransportError,
+  type EmailTransport,
+  type OutgoingMessage,
+} from "./types.ts";
+
+// Sends through the Gmail API (users.messages.send) with the mailbox's own
+// OAuth grant, scope gmail.send. The message goes up as raw MIME, so what
+// arrives is exactly what was composed.
+// https://developers.google.com/gmail/api/reference/rest/v1/users.messages/send
+
+export const GMAIL_API_BASE = "https://gmail.googleapis.com";
+
+/**
+ * Gmail takes messages up to 35 MB as sent; base64url makes the upload a
+ * third larger than the attachments, and the request is capped too, so
+ * attachments stay at 25 MB.
+ */
+export const GMAIL_MAX_ATTACHMENT_BYTES = 25 * 1024 * 1024;
+
+type GmailTransportOptions = {
+  apiBase?: string;
+  fetch?: typeof fetch;
+  /** A current access token; refreshed by the caller when it runs out. */
+  getAccessToken: () => Promise<string>;
+};
+
+async function readError(response: Response): Promise<string> {
+  const body = (await response.json().catch(() => null)) as {
+    error?: { message?: string; status?: string };
+  } | null;
+
+  return (
+    body?.error?.message ??
+    `Gmail refused the message (HTTP ${String(response.status)}).`
+  );
+}
+
+export function createGmailTransport({
+  apiBase = GMAIL_API_BASE,
+  fetch: fetchImpl = fetch,
+  getAccessToken,
+}: GmailTransportOptions): EmailTransport {
+  return {
+    maxAttachmentBytes: GMAIL_MAX_ATTACHMENT_BYTES,
+    provider: "gmail",
+    async send(message: OutgoingMessage) {
+      const raw = (await buildRawMime(message)).toString("base64url");
+      const accessToken = await getAccessToken();
+      let response: Response;
+
+      try {
+        response = await fetchImpl(
+          `${apiBase}/gmail/v1/users/me/messages/send`,
+          {
+            body: JSON.stringify({ raw }),
+            headers: {
+              authorization: `Bearer ${accessToken}`,
+              "content-type": "application/json",
+            },
+            method: "POST",
+            signal: AbortSignal.timeout(30_000),
+          },
+        );
+      } catch (error) {
+        throw fetchFailure(error, "Gmail");
+      }
+
+      if (!response.ok) {
+        throw new EmailTransportError(await readError(response), {
+          kind: kindForHttpStatus(response.status),
+          retryAfterMs: retryAfterMs(response.headers.get("retry-after")),
+          statusCode: response.status,
+        });
+      }
+
+      const body = (await response.json().catch(() => null)) as {
+        id?: string;
+      } | null;
+
+      return { providerMessageId: body?.id };
+    },
+  };
+}
diff --git a/src/lib/email/microsoft.ts b/src/lib/email/microsoft.ts
new file mode 100644
index 0000000..9b4df3f
--- /dev/null
+++ b/src/lib/email/microsoft.ts
@@ -0,0 +1,127 @@
+import { fetchFailure, kindForHttpStatus, retryAfterMs } from "./classify.ts";
+import {
+  EmailTransportError,
+  type EmailTransport,
+  type OutgoingMessage,
+} from "./types.ts";
+
+// Sends through Microsoft Graph (POST /me/sendMail) with the mailbox's own
+// OAuth grant, scope Mail.Send. Works for Microsoft 365 work and school
+// mailboxes and for Outlook.com / Hotmail.
+// https://learn.microsoft.com/graph/api/user-sendmail
+
+export const GRAPH_API_BASE = "https://graph.microsoft.com";
+
+/**
+ * Graph takes a request of up to 4 MB, attachments included, and the
+ * attachments go inline as base64. Kept at 3 MB of files; callers send
+ * download links instead when the files are larger (fitsAsAttachments).
+ */
+export const GRAPH_MAX_ATTACHMENT_BYTES = 3 * 1024 * 1024;
+
+type MicrosoftTransportOptions = {
+  apiBase?: string;
+  fetch?: typeof fetch;
+  getAccessToken: () => Promise<string>;
+};
+
+export function buildGraphSendMailBody(message: OutgoingMessage) {
+  return {
+    message: {
+      attachments: message.attachments.map((attachment) => ({
+        "@odata.type": "#microsoft.graph.fileAttachment",
+        contentBytes: Buffer.from(attachment.content).toString("base64"),
+        contentType: attachment.contentType,
+        name: attachment.filename,
+      })),
+      body: message.htmlBody
+        ? { content: message.htmlBody, contentType: "HTML" }
+        : { content: message.textBody, contentType: "Text" },
+      ...(message.replyTo
+        ? { replyTo: [{ emailAddress: { address: message.replyTo } }] }
+        : {}),
+      subject: message.subject,
+      toRecipients: [{ emailAddress: { address: message.to } }],
+    },
+    saveToSentItems: true,
+  };
+}
+
+async function readError(response: Response): Promise<{
+  code: string | null;
+  message: string;
+}> {
+  const body = (await response.json().catch(() => null)) as {
+    error?: { code?: string; message?: string };
+  } | null;
+
+  return {
+    code: body?.error?.code ?? null,
+    message:
+      body?.error?.message ??
+      `Microsoft refused the message (HTTP ${String(response.status)}).`,
+  };
+}
+
+export function createMicrosoftTransport({
+  apiBase = GRAPH_API_BASE,
+  fetch: fetchImpl = fetch,
+  getAccessToken,
+}: MicrosoftTransportOptions): EmailTransport {
+  return {
+    maxAttachmentBytes: GRAPH_MAX_ATTACHMENT_BYTES,
+    provider: "microsoft",
+    async send(message: OutgoingMessage) {
+      const size = message.attachments.reduce(
+        (total, attachment) => total + attachment.content.byteLength,
+        0,
+      );
+
+      if (size > GRAPH_MAX_ATTACHMENT_BYTES) {
+        throw new EmailTransportError(
+          "The attachments are too large for Microsoft to send. Send download links instead.",
+          { code: "attachments_too_large", kind: "permanent" },
+        );
+      }
+
+      const accessToken = await getAccessToken();
+      let response: Response;
+
+      try {
+        response = await fetchImpl(`${apiBase}/v1.0/me/sendMail`, {
+          body: JSON.stringify(buildGraphSendMailBody(message)),
+          headers: {
+            authorization: `Bearer ${accessToken}`,
+            "content-type": "application/json",
+          },
+          method: "POST",
+          signal: AbortSignal.timeout(30_000),
+        });
+      } catch (error) {
+        throw fetchFailure(error, "Microsoft Graph");
+      }
+
+      if (!response.ok) {
+        const { code, message: text } = await readError(response);
+
+        throw new EmailTransportError(text, {
+          code,
+          // A mailbox without an Exchange Online licence, or one whose
+          // sending was blocked, answers 403 too: either way the account
+          // has to be looked at, not the message.
+          kind: kindForHttpStatus(response.status),
+          retryAfterMs: retryAfterMs(response.headers.get("retry-after")),
+          statusCode: response.status,
+        });
+      }
+
+      // 202 Accepted, with no body and no message id. Graph's request id
+      // is what Microsoft support asks for, so that is kept instead.
+      const requestId = response.headers.get("request-id");
+
+      return {
+        providerMessageId: requestId ? `graph-request-${requestId}` : undefined,
+      };
+    },
+  };
+}
diff --git a/src/lib/email/mime.ts b/src/lib/email/mime.ts
new file mode 100644
index 0000000..715e7f2
--- /dev/null
+++ b/src/lib/email/mime.ts
@@ -0,0 +1,27 @@
+import MailComposer from "nodemailer/lib/mail-composer";
+
+import { type OutgoingMessage } from "./types.ts";
+
+/** The message as nodemailer takes it, for SMTP and for raw MIME. */
+export function toNodemailerMessage(message: OutgoingMessage) {
+  return {
+    attachments: message.attachments.map((attachment) => ({
+      content: Buffer.from(attachment.content),
+      contentType: attachment.contentType,
+      filename: attachment.filename,
+    })),
+    from: message.from.name
+      ? { address: message.from.address, name: message.from.name }
+      : message.from.address,
+    html: message.htmlBody,
+    replyTo: message.replyTo ?? undefined,
+    subject: message.subject,
+    text: message.textBody,
+    to: message.to,
+  };
+}
+
+/** The whole message as RFC 5322 bytes, as Gmail's API takes it. */
+export async function buildRawMime(message: OutgoingMessage): Promise<Buffer> {
+  return new MailComposer(toNodemailerMessage(message)).compile().build();
+}
