# Copy to .env.selfhost and fill in. Never commit the filled-in copy.
# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 32  (keep it: it protects the seal key and saved credentials)
BETTER_AUTH_SECRET=
# The address people open, e.g. https://sign.yourcompany.com
APP_URL=http://localhost:8080
PACTORA_PORT=8080
# smtps://user:app-password@smtp.yourprovider.com:465 (optional)
PLATFORM_SMTP_URL=
PLATFORM_EMAIL_FROM=
# 1 only when the site sits behind your own access gate
PACTORA_ACCESS_PROTECTED=
# "off" only when the server cannot reach api.pwnedpasswords.com
PASSWORD_BREACH_CHECK=
